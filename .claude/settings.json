{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-attribution.sh",
            "if": "Bash(git commit*)",
            "statusMessage": "Checking commit message for prohibited attribution lines"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/stop-checks.sh",
            "statusMessage": "Running fmt and clippy checks"
          }
        ]
      }
    ]
  }
}